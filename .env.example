# 探嘉后端配置
NODE_ENV=development
PORT=4173
SYNC_INTERVAL_HOURS=12
# 领星原始库存分类账正式全量重建默认关闭。真实文件 dry-run 审核通过后才可手工启用。
INVENTORY_LEDGER_REBUILD_ENABLED=false
INVENTORY_LEDGER_REBUILD_AT=02:00
# 本地开发和自动化测试可显式使用 mock。生产部署必须设置 NODE_ENV=production、
# DATA_PROVIDER=lingxing，并同时填写 LINGXING_APP_KEY / LINGXING_APP_SECRET。
DATA_PROVIDER=mock
DASHBOARD_START_DATE=
DASHBOARD_END_DATE=

# 拿到领星正式接口文档后再填写。不要把真实密钥提交到代码仓库。
LINGXING_BASE_URL=https://openapi.lingxing.com
LINGXING_APP_KEY=
LINGXING_APP_SECRET=
LINGXING_ACCESS_TOKEN=
LINGXING_REFRESH_TOKEN=
LINGXING_PAYABLE_PURCHASE_ENDPOINT=/basicOpen/finance/requestFundsPool/purchase/list
LINGXING_PAYABLE_LOGISTICS_ENDPOINT=/basicOpen/finance/requestFundsPool/logistics/list
LINGXING_PAYABLE_OTHER_ENDPOINT=
LINGXING_SUPPLIER_SALES_STAT_ENDPOINT=/basicOpen/platformStatisticsV2/saleStat/pageList
LINGXING_BUYER_MESSAGE_ENDPOINT=/erp/sc/data/mail/lists
# 领星 ERP 售后邮箱接口要求填写“店铺绑定邮箱”，多个邮箱用英文逗号分隔。
LINGXING_BUYER_MESSAGE_EMAILS=
# 站内信归属店铺映射，格式：邮箱=店铺名，多个用英文逗号分隔。
LINGXING_BUYER_MESSAGE_EMAIL_STORE_MAP=joimew@163.com=xiamentanjia-US,mxndrl@163.com=tandanbo
LINGXING_BUYER_MESSAGE_FLAG=receive
# ERP 站内信巡检窗口；默认查今天和昨天，避免 30 天历史邮件反复提醒。
LINGXING_BUYER_MESSAGE_RECENT_DAYS=2
# 可选：用网易邮箱“已发送”校验 ERP 站内信是否已在邮箱侧回复。
# 格式：邮箱:授权码，多个账号用英文逗号分隔；授权码里如包含冒号可改用 邮箱|授权码。
LINGXING_BUYER_MESSAGE_REPLY_MAILBOXES=
LINGXING_BUYER_MESSAGE_REPLY_IMAP_HOST=imap.163.com
LINGXING_BUYER_MESSAGE_REPLY_IMAP_PORT=993
LINGXING_BUYER_MESSAGE_REPLY_SENT_MAILBOX=已发送
LINGXING_BUYER_MESSAGE_REPLY_LOOKBACK_DAYS=14
LINGXING_BUYER_MESSAGE_REPLY_MAX_MESSAGES=200
LINGXING_SELLER_FEEDBACK_ENDPOINT=/erp/sc/cs/feedback/listMws

# 九方通逊物流 API。真实 token / 密码哈希只写服务器 .env，不提交到代码仓库。
JIUFANG_API_BASE_URL=https://cgi.jiufanglogistics.cn/api/
JIUFANG_USERNAME=
# 九方文档要求 Password 使用 MD5 32 位小写；不要填写原始密码。
JIUFANG_PASSWORD_MD5=
JIUFANG_TOKEN=
JIUFANG_DEFAULT_DEPARTURE_CODE=SZ
JIUFANG_DEFAULT_SERVICE_CODE=

# 店铺自动巡检。当前聚焦 feedback、review、买家之声和 Performance - Account Health。
STORE_INSPECTION_ENABLED=true
STORE_INSPECTION_INTERVAL_HOURS=24
STORE_INSPECTION_SEND_TIME=08:30
STORE_INSPECTION_LOOKBACK_DAYS=30
STORE_INSPECTION_NOTIFY_ENABLED=false
STORE_INSPECTION_NOTIFY_ON_CLEAN=true
# 店铺负责人和钉钉 userId，代码内已有默认值；这里可覆盖或补充，多个用英文逗号分隔。
STORE_INSPECTION_DINGTALK_USERS=林芃=2221374053956163143,熊丹轩=361967580828589914,黄超=22381010461296193
STORE_INSPECTION_STORE_OWNERS=xiamentanjia-US=林芃,tanjia-eu-DE=林芃,xiamentanjia-CA=熊丹轩,xiamentanjia-AU=黄超,tandanbo-US=熊丹轩,tandanbo-CA=熊丹轩,tandanbo-AU=黄超

# 钉钉群机器人 webhook。正式值只放服务器 .env，不要写进代码。
DINGTALK_WEBHOOK=
DINGTALK_SECRET=
# 钉钉机器人定向 @。手机号或 userId 多个用英文逗号分隔；消息正文会自动追加 @ 文本。
DINGTALK_AT_MOBILES=
DINGTALK_AT_USER_IDS=

# FBA 刷仓任务专用钉钉群机器人 webhook。正式值只放服务器 .env，不要写进代码。
FBA_DINGTALK_WEBHOOK=
FBA_DINGTALK_SECRET=
FBA_DINGTALK_AT_MOBILES=
FBA_DINGTALK_AT_USER_IDS=

# 登录认证。普通成员使用钉钉扫码登录；仅保留一个环境变量管理员账号密码入口。
AUTH_ENABLED=true
AUTH_COOKIE_SECURE=false
SESSION_SECRET=
AUTH_USERNAME=
AUTH_PASSWORD=
# 部署后销售复盘冒烟检查。留空时回退使用 AUTH_USERNAME/AUTH_PASSWORD；建议配置专用只读账号。
DEPLOY_SALES_REVIEW_SMOKE_USERNAME=
DEPLOY_SALES_REVIEW_SMOKE_PASSWORD=
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_REDIRECT_URI=http://47.107.92.14/api/auth/dingtalk/callback

# 小米 MiMo OpenAI 兼容接口。真实密钥只写服务器 .env，不提交到代码仓库。
AI_PROVIDER=modelscope
MODELSCOPE_API_ENDPOINT=https://api-inference.modelscope.cn/v1
MODELSCOPE_API_KEY=
MODELSCOPE_MODEL=deepseek-ai/DeepSeek-V4-Flash
MODELSCOPE_TIMEOUT_MS=120000
MODELSCOPE_MAX_OUTPUT_TOKENS=3000
MIMO_API_ENDPOINT=https://api.xiaomimimo.com/v1/chat/completions
MIMO_API_KEY=
MIMO_MODEL=mimo-v2.5-pro-ultraspeed
MIMO_TIMEOUT_MS=120000
MIMO_MAX_COMPLETION_TOKENS=3000
